{
  "manifest_version": 3,
  "name": "WhatNext? — Stop Scrolling. Start Doing.",
  "short_name": "WhatNext?",
  "version": "1.0.0",
  "description": "A privacy-first recommendation engine that tells you the single most valuable thing to do next — movies, projects, learning, fitness, career, and more.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/index.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "options_page": "options/index.html",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "permissions": ["storage", "alarms", "notifications", "contextMenus", "tabs"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "commands": {
    "whatnext-instant": {
      "suggested_key": { "default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y" },
      "description": "Show what to do next"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
